DEBUG=True
SECRET_KEY=generate-a-long-secure-random-phrase-here

# Database Configuration
# SQLite fallback is used if DATABASE_URL is not provided
# Postgres Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# DATABASE_URL=postgres://lqis_user:super_secret@localhost:5432/lqis_db

# Allowed Hosts (comma-separated, e.g. "lqis-app.onrender.com,127.0.0.1")
ALLOWED_HOSTS="*"

# Cloudinary Integration (Required for Production Image Hosting)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Email Sender Settings (Optional but necessary for weekly reports)
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Sentry Error Tracking (Optional — free at sentry.io)
# SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Demo Mode (Set to True ONLY for demo/staging builds, NEVER in production)
# DEMO_MODE_ENABLED=False
